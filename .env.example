# ---- Core ----
APP_URL=http://localhost:3000                 # public https URL in production (webhooks, OAuth redirect)
DATABASE_URL=postgres://jawab:jawab@localhost:5432/jawab
# Supabase: DATABASE_URL = transaction pooler (port 6543). DATABASE_URL_LISTEN = session pooler or direct (port 5432),
# needed for the live inbox (Postgres LISTEN/NOTIFY) and for migrations.
DATABASE_URL_LISTEN=
AUTH_SECRET=                                  # 32+ random chars: openssl rand -base64 48
APP_ENCRYPTION_KEY=                           # encrypts channel tokens / Google tokens at rest: openssl rand -base64 32

# ---- AI Providers (Automatic Multi-Provider Cascading Fallback) ----
# Add any of these keys. If one hits rate limits (429), Jawab automatically falls back to the next!
# 1. Groq (Free forever, ultra-fast 500 tok/sec, 30 RPM): https://console.groq.com
GROQ_API_KEY=
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Free tier, 15 RPM, 1M TPM): https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-1.5-flash
GEMINI_SMART_MODEL=gemini-2.0-flash

# 3. OpenRouter (Free tier models with :free suffix): https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SMART_MODEL=google/gemini-2.0-flash-exp:free

# 4. Ollama (Completely free, runs locally on your machine): https://ollama.com
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# 5. OpenAI
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# 6. Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5

# ---- Demo ----
DEMO_MODE=true
DEMO_WORKSPACE_ID=FORNO7
DEMO_PASSWORD=forno7demo                      # password for owner@demo, service@demo, hr@demo
DEMO_RESET_TOKEN=                             # optional: POST /api/demo/reset with Authorization: Bearer <token>

# ---- Telegram: the shared Jawab bot (businesses can also connect their own bot in Settings) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=                        # without @, used for customer links, QR codes and link codes
TELEGRAM_WEBHOOK_SECRET=                      # A-Z a-z 0-9 _ - (1-256 chars)
TELEGRAM_HR_CHANNEL_ID=                       # optional: jobs channel/group id(s), comma separated (auto-detected when the bot is made admin)
HR_TELEGRAM_CHAT_ID=                          # optional: HR's own chat id, notified when a candidate books

# ---- WhatsApp (Cloud API) ----
# Businesses paste their own number's credentials in Settings → Channels. These env values are only for
# Jawab's own Meta app (platform webhook /api/webhooks/whatsapp) and the demo workspace's number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# ---- Instagram (Instagram API with Instagram Login) ----
# Jawab's Meta app: businesses connect with "Connect Instagram" (redirect URI {APP_URL}/api/channels/instagram/callback).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=                         # also verifies webhook signatures; defaults to META_APP_SECRET
INSTAGRAM_ACCESS_TOKEN=                       # optional: demo workspace's account without going through Connect
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=                       # defaults to WHATSAPP_VERIFY_TOKEN
INSTAGRAM_GRAPH_VERSION=v26.0

# ---- Google Calendar (optional; built-in calendar otherwise) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Zoom (optional, not used yet: video interviews use Google Meet or a Jitsi link) ----
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Ops ----
CRON_SECRET=                                  # Vercel sends it as Bearer on cron calls to /api/jobs/sweep (retries, CV retention, Instagram token refresh)
