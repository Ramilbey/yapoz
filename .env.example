# ---- Core ----
APP_URL=http://localhost:3000                 # public https URL in production (webhooks, OAuth redirect)
DATABASE_URL=postgres://jawab:jawab@localhost:5432/jawab
# Supabase: DATABASE_URL = transaction pooler (port 6543). DATABASE_URL_LISTEN = session pooler or direct (port 5432),
# needed for the live inbox (Postgres LISTEN/NOTIFY) and for migrations.
DATABASE_URL_LISTEN=
AUTH_SECRET=                                  # 32+ random chars: openssl rand -base64 48
APP_ENCRYPTION_KEY=                           # encrypts channel tokens at rest: openssl rand -base64 32

# ---- Sign-up protection (both are required in production; sign-up is refused without them) ----
# Cloudflare Turnstile, the human check: https://dash.cloudflare.com → Turnstile → Add widget
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend, sends the 6-digit email code: https://resend.com. Without a key, local dev prints the code in the server console.
RESEND_API_KEY=
EMAIL_FROM=Yapoz <hello@yourdomain.com>       # must use a domain verified in Resend

# ---- AI Providers (Automatic Multi-Provider Cascading Fallback) ----
# Add any of these keys. If one hits rate limits (429), Yapoz automatically falls back to the next!
# 1. Groq (Free forever, ultra-fast 500 tok/sec, 30 RPM): https://console.groq.com
GROQ_API_KEY=
# Leave the model names empty: Yapoz asks Groq which models it serves and picks the best (models get retired often).
# Set one only to pin it; if Groq stops serving a pinned model, Yapoz falls back to the best served one.
GROQ_FAST_MODEL=
GROQ_SMART_MODEL=

# 2. Google Gemini (Free tier, 15 RPM, 1M TPM): https://aistudio.google.com
GEMINI_API_KEY=
# Leave the model names empty: Yapoz lists what the key can use and picks the newest stable Flash / Flash-Lite.
# (gemini-2.5-* is now limited to keys that used it before: "model not found".)
GEMINI_FAST_MODEL=
GEMINI_SMART_MODEL=

# 3. OpenRouter (Free tier models with :free suffix): https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SMART_MODEL=google/gemini-2.0-flash-exp:free

# 4. Ollama (Completely free, runs locally on your machine): https://ollama.com
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# 5. OpenAI
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_SMART_MODEL=gpt-4o

# 6. Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5

# ---- Demo ----
DEMO_MODE=true
DEMO_WORKSPACE_ID=FORNO7
DEMO_PASSWORD=forno7demo                      # password for owner@demo and service@demo
DEMO_RESET_TOKEN=                             # optional: POST /api/demo/reset with Authorization: Bearer <token>

# ---- Telegram: the shared Yapoz bot (businesses can also connect their own bot in Settings) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=                        # without @, used for customer links, QR codes and link codes
TELEGRAM_WEBHOOK_SECRET=                      # A-Z a-z 0-9 _ - (1-256 chars)

# ---- Meta app + WhatsApp (Cloud API) ----
# Businesses save their own in Settings → Channels (Meta app box, then WhatsApp number). These env values are only for
# Yapoz's own Meta app (platform webhook /api/webhooks/whatsapp) and the demo workspace's number.
# Yapoz's own Meta app, used for Embedded Signup (Connect with Facebook) and the demo number:
META_APP_ID=                                  # App settings → Basic → App ID
META_APP_SECRET=                              # App settings → Basic → App secret
# Facebook Login for Business configuration ID for WhatsApp Embedded Signup (Login configurations):
META_EMBEDDED_SIGNUP_CONFIG_ID=
# WhatsApp number:
WHATSAPP_PHONE_NUMBER_ID=                     # WhatsApp → API Setup → Phone number ID (not the phone number)
WHATSAPP_BUSINESS_ACCOUNT_ID=                 # WhatsApp → API Setup → WhatsApp Business Account ID
WHATSAPP_TOKEN=                               # System User access token (whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_VERIFY_TOKEN=                        # you choose it; paste the same value in Meta's webhook settings
META_GRAPH_VERSION=v26.0


# ---- Ops ----
CRON_SECRET=                                  # Sent as "Authorization: Bearer ..." to /api/jobs/sweep (retries, order expiry, booking reminders, retention). Call it about every 5 minutes.
